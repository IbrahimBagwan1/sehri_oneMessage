# Frontend env — copy this file to `.env` (same directory) and fill in
# your own values. Expo automatically inlines any variable prefixed with
# EXPO_PUBLIC_ at bundle time so the running app can read it via
# `process.env.EXPO_PUBLIC_*`.
#
# After changing this file, RESTART `npx expo start`. Expo only reads
# env vars at bundle time — hot-reload does not pick them up.

# ---------------------------------------------------------------------------
# API base URL — where the app sends every REST + Socket.IO request.
# Include the trailing `/api` (Socket.IO strips it internally).
#
# Pick the ONE line that matches how you're running the app:
#
#   1) ngrok tunnel (real device off Wi-Fi, or Expo Go with --tunnel).
#      Run `ngrok http 5000`, then copy the "Forwarding" https:// URL
#      it prints and append `/api`. The URL changes every time you
#      restart ngrok unless you have a reserved domain.
#
#         EXPO_PUBLIC_API_BASE_URL=https://<your-ngrok-subdomain>.ngrok-free.dev/api
#
#   2) Android emulator on the same machine as the backend.
#      Android maps 10.0.2.2 to the host loopback.
#
#         EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:5000/api
#
#   3) iOS simulator on the same machine as the backend.
#
#         EXPO_PUBLIC_API_BASE_URL=http://localhost:5000/api
#
#   4) Physical device on the same Wi-Fi as the backend host.
#      Replace 192.168.x.x with your dev machine's LAN IP
#      (run `ipconfig` on Windows, `ifconfig` on macOS/Linux).
#
#         EXPO_PUBLIC_API_BASE_URL=http://192.168.x.x:5000/api
#
# ---------------------------------------------------------------------------
EXPO_PUBLIC_API_BASE_URL=https://your-ngrok-subdomain.ngrok-free.dev/api
