# Frontend env — copy this file to `.env` (same directory) for LOCAL
# development. Store builds do not read this file: they take their values
# from eas.json and EAS environment variables (`eas env:create`) — see
# docs/release/LAUNCH_CHECKLIST.md.
#
# EXPO_PUBLIC_* variables are inlined into the JavaScript bundle at build
# time, so they must never hold a secret. After changing this file, restart
# `npx expo start`.

# ---------------------------------------------------------------------------
# API base URL — every REST and Socket.IO request goes here. Include the
# trailing /api. Release builds REQUIRE https:// (an http:// URL is replaced
# with an unreachable placeholder so the mistake is loud).
#
#   ngrok tunnel:            https://<subdomain>.ngrok-free.dev/api
#   Android emulator:        http://10.0.2.2:5000/api
#   iOS simulator:           http://localhost:5000/api
#   Device on same Wi-Fi:    http://192.168.x.x:5000/api
# ---------------------------------------------------------------------------
EXPO_PUBLIC_API_BASE_URL=https://your-ngrok-subdomain.ngrok-free.dev/api

# development | preview | production — tags crash reports.
EXPO_PUBLIC_APP_ENV=development

# Crash reporting (Sentry). Leave empty to disable. The DSN is not a secret.
EXPO_PUBLIC_SENTRY_DSN=

# ---------------------------------------------------------------------------
# Native build configuration (read by app.config.js, not by the app code).
# ---------------------------------------------------------------------------
# Google Maps SDK keys — one per platform, each restricted in Google Cloud to
# the app (Android: package name + SHA-1 of the signing key; iOS: bundle id)
# and to the "Maps SDK for Android/iOS" API only.
GOOGLE_MAPS_ANDROID_API_KEY=
GOOGLE_MAPS_IOS_API_KEY=
# The final bundle identifier / package name. Permanent once published.
# Development builds default to com.anonymous.onemessage.
APP_BUNDLE_ID=
# From `eas init` — needed for push tokens in real builds.
EAS_PROJECT_ID=
EXPO_OWNER=
# Sentry source-map upload during EAS builds (the auth token is a secret —
# set SENTRY_AUTH_TOKEN as an EAS secret, never here).
SENTRY_ORG=
SENTRY_PROJECT=
