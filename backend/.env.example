# OneMessage API — environment.
# Copy to .env and fill in. The server validates this on boot
# (src/config/env.js) and refuses to start on a missing, EMPTY, or unsafe
# value, listing every problem at once.

# --- Server -----------------------------------------------------------------
PORT=5000
NODE_ENV=development
# Browser origins allowed by CORS, comma-separated. The mobile app sends no
# Origin header and does not need an entry. In production, empty means "no
# browser origin"; '*' is refused.
CORS_ORIGIN=
# Number of reverse proxies in front of the API (nginx, a load balancer).
TRUST_PROXY=1
# info in production, debug otherwise. LOG_TO_FILE=true adds rotated files
# under logs/ (console is always on and is what hosting platforms collect).
LOG_LEVEL=
LOG_TO_FILE=false

# --- Database -----------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=sehri_connect
DB_USER=root
DB_PASS=pass
# Connections per process. Leave headroom under MySQL's max_connections.
DB_POOL_MAX=10
# TLS to the database — required by most managed MySQL providers.
DB_SSL=false
# Only for a provider with a self-signed certificate chain.
DB_SSL_REJECT_UNAUTHORIZED=true
# Log every SQL statement (development only).
DB_LOG_SQL=false

# --- Auth ---------------------------------------------------------------------
# Two DIFFERENT random strings, each at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace_with_a_long_random_string
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
# Access tokens are not checked against the session table per request, so
# this is how long a revoked session's last access token keeps working.
# 15m in production.
JWT_ACCESS_EXPIRES_IN=15m
# Sliding session lifetime; each refresh extends it.
JWT_REFRESH_EXPIRES_IN=30d

# --- OTP / SMS ------------------------------------------------------------------
# 'messagecentral' in production (required). 'local' is development-only: it
# writes the code to the server log instead of sending an SMS.
OTP_PROVIDER=messagecentral
OTP_EXPIRY_MINUTES=5
MESSAGECENTRAL_AUTH_TOKEN=
MESSAGECENTRAL_CUSTOMER_ID=
# Window for the per-IP OTP send/verify limits.
RATE_LIMIT_WINDOW_MINUTES=15

# --- App Review / Play review sandbox ------------------------------------------
# Off by default. When true, a demo member (and optionally a demo rider) can
# sign in with the password below, the demo phone accepts the fixed OTP
# instead of an SMS, and both live in a hidden sandbox zone that never touches
# real data. See src/services/reviewDemoService.js and docs/release/.
# Turn it off once the app is approved.
REVIEW_DEMO_ENABLED=false
# Use numbers you control and that are not real members' numbers.
REVIEW_DEMO_PHONE=
REVIEW_DEMO_RIDER_PHONE=
# At least 10 characters.
REVIEW_DEMO_PASSWORD=
# Exactly 6 digits. Accepted for REVIEW_DEMO_PHONE only.
REVIEW_DEMO_OTP=

# --- Chat -------------------------------------------------------------------------
# Extra words the chat filter refuses, comma-separated, matched as whole
# words. A conservative built-in list always applies (src/services/contentFilter.js).
CHAT_BLOCKED_TERMS=

# --- Prayer timings (defaults to Bangalore) ---------------------------------------
PRAYER_LATITUDE=12.9716
PRAYER_LONGITUDE=77.5946
PRAYER_CITY=Bangalore
PRAYER_COUNTRY=India
PRAYER_TIMEZONE=Asia/Kolkata

# --- Google Maps (server key) -------------------------------------------------------
# A SERVER key, separate from the app's Android/iOS SDK keys. Enable:
# Directions API, Geocoding API, Distance Matrix API. Restrict it by API
# (those three) and, if your host has a fixed egress IP, by IP address.
GOOGLE_MAPS_API_KEY=

# --- Cloudinary (donation screenshots) ----------------------------------------------
# Either the combined CLOUDINARY_URL (recommended) or the three split vars.
CLOUDINARY_URL=
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# --- Live delivery tracking -----------------------------------------------------------
# The proximity push fires once per recipient when their ETA along the
# rider's route first drops to or below this.
PROXIMITY_ETA_MINUTES=5
# One Directions request per recompute. Never more often than MIN_SECONDS;
# after that, when the team has moved MIN_METERS or MAX_SECONDS has passed.
ETA_RECOMPUTE_MIN_SECONDS=60
ETA_RECOMPUTE_MIN_METERS=100
ETA_RECOMPUTE_MAX_SECONDS=180
# Handover time added per earlier stop on the route.
ETA_STOP_DWELL_SECONDS=90

# --- Payments (public) -------------------------------------------------------------------
# Shown on the Android donate screen and on /payment.html (opened from iOS).
PAYMENT_CONTACT_NUMBER=+91 96327 16392

# --- Islamic content sync ---------------------------------------------------------------
#   Quran: node scripts/sync-quran.js   Duas: node scripts/sync-duas.js
QURAN_API_BASE_URL=https://api.quran.com/api/v4
# Translation resource id (131 = Saheeh International).
ISLAMIC_API_TRANSLATION_ID=131
ISLAMIC_API_DELAY_MS=200

# --- Tests ---------------------------------------------------------------------------------
# `npm test` recreates <DB_NAME>_test. Only set this with
# `node tests/run.js --existing-db` (see tests/run.js).
# TEST_DB_NAME=
