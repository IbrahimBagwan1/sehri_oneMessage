# Server
PORT=5000
NODE_ENV=development
# Comma-separated list of origins allowed by CORS in production
# (leave empty in development to allow all)
CORS_ORIGIN=

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=sehri_connect
DB_USER=root
DB_PASS=pass

# JWT
JWT_SECRET=replace_with_a_long_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_REFRESH_EXPIRES_IN=30d

# OTP / SMS (fill in once you have provider credentials)
OTP_PROVIDER=messagecentral
OTP_EXPIRY_MINUTES=5
MESSAGECENTRAL_AUTH_TOKEN=
MESSAGECENTRAL_CUSTOMER_ID=

# Rate limiting
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=100

# Prayer timings location (defaults to Bangalore if not set)
PRAYER_LATITUDE=12.9716
PRAYER_LONGITUDE=77.5946
PRAYER_CITY=Bangalore
PRAYER_COUNTRY=India
PRAYER_TIMEZONE=Asia/Kolkata

# Google Maps API — used for server-side reverse geocoding fallback on
# rider location pushes and for the /api/tracking/eta driving-ETA endpoint.
# Get a key at https://console.cloud.google.com/apis/credentials and
# enable: Geocoding API, Distance Matrix API.
GOOGLE_MAPS_API_KEY=

# Cloudinary — stores donation-payment screenshots.
# Get credentials at https://cloudinary.com/console. Either set the
# combined CLOUDINARY_URL (recommended) OR the three split vars below.
CLOUDINARY_URL=
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Live delivery tracking — ETA + proximity notifications.
# The proximity push fires once per recipient when their ETA first
# drops to or below this value.
PROXIMITY_ETA_MINUTES=5
# Skip a Distance Matrix recompute unless BOTH: rider has moved this
# far since the last recompute, AND at least this many seconds have
# passed. RECOMPUTE_MAX_SECONDS forces a recompute regardless (so the
# countdown ticks down when the rider is stopped at a light).
ETA_RECOMPUTE_MIN_METERS=100
ETA_RECOMPUTE_MIN_SECONDS=30
ETA_RECOMPUTE_MAX_SECONDS=120

# UPI / phone number displayed on the donation payment page (public).
# The Android app shows this number inline; the iOS app opens the hosted
# /payment.html page (which fetches this same number via /api/payment/info).
PAYMENT_CONTACT_NUMBER=+91 96327 16392

# Islamic content sync.
#   • Quran — pulled from api.quran.com v4 (free, keyless, well-maintained).
#     Run: node scripts/sync-quran.js
#   • Duas — bundled locally at backend/src/data/duas-seed.json.
#     Run: node scripts/sync-duas.js
QURAN_API_BASE_URL=https://api.quran.com/api/v4
# Translation resource id used when fetching verses (default 131 = Sahih International).
ISLAMIC_API_TRANSLATION_ID=131
# Politeness delay between upstream calls (ms).
ISLAMIC_API_DELAY_MS=200
