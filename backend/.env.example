sr# Server
PORT=5000
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=sehri_connect
DB_USER=root
DB_PASS=pass

# JWT
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_REFRESH_EXPIRES_IN=30d

# OTP / SMS (fill in once you have provider credentials)
OTP_PROVIDER=messagecentral
OTP_EXPIRY_MINUTES=5
MESSAGECENTRAL_AUTH_TOKEN=
MESSAGECENTRAL_CUSTOMER_ID=

# Rate limiting
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=100

# Prayer timings location (defaults to Bangalore if not set)
PRAYER_LATITUDE=12.9716
PRAYER_LONGITUDE=77.5946
PRAYER_CITY=Bangalore
PRAYER_COUNTRY=India
PRAYER_TIMEZONE=Asia/Kolkata
